---
import Icon from './Icon.astro';

interface Props {
  label: string;
  hint?: string;
  compact?: boolean;
}

const { label, hint, compact = false } = Astro.props;
const attrs = compact ? 'media-ph media-ph--compact' : 'media-ph';
---

<div class={attrs} role="img" aria-label={label}>
  <span class="media-ph__cam">
    <Icon name="camera" size={compact ? 14 : 18} />
  </span>
  <span class="media-ph__label">{label}</span>
  {hint && (
    <span class="media-ph__hint">
      <span class="media-ph__hint-tag">الصورة المطلوبة</span>
      {hint}
    </span>
  )}
</div>

<style>
  .media-ph {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    min-height: 150px;
    padding: 16px;
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-gold-light));
    border: 1.5px dashed var(--color-border-dark);
    border-radius: 14px;
    overflow: hidden;
    isolation: isolate;
  }
  .media-ph::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px dashed rgba(7, 123, 67, 0.25);
    border-radius: 10px;
    pointer-events: none;
    z-index: -1;
  }
  .media-ph__cam {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-secondary);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 10px rgba(23, 32, 46, 0.1);
  }
  .media-ph__label {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-primary-dark);
  }
  .media-ph__hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.76rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 94%;
  }
  .media-ph__hint-tag {
    font-size: 0.64rem;
    font-weight: 800;
    color: #202022;
    background: var(--color-gold);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .media-ph--compact {
    min-height: 0;
    padding: 12px;
    gap: 5px;
  }
  .media-ph--compact::before {
    inset: 5px;
  }
  .media-ph--compact .media-ph__cam {
    width: 30px;
    height: 30px;
  }
  .media-ph--compact .media-ph__label {
    font-size: 0.78rem;
  }
  .media-ph--compact .media-ph__hint {
    font-size: 0.7rem;
  }
</style>