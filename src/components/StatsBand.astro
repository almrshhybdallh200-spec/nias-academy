---
import { siteConfig } from '../lib/data';
import Icon from './Icon.astro';

const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);

const statList = [
  { count: siteConfig.stats.years, label: 'عامًا من العطاء', icon: 'award' },
  { count: siteConfig.stats.graduates, label: 'خريج ومتدرب', icon: 'users' },
  { count: siteConfig.stats.programs, label: 'برنامجًا تدريبيًا', icon: 'layers' },
  { count: siteConfig.stats.branches, label: 'فروع في المحافظات', icon: 'map-pin' },
];
---

<section class="stats-band" aria-label="أرقام المعهد">
  <div class="container">
    <div class="stats-band__grid" data-reveal>
      {statList.map((s, i) => (
        <div class="stats-band__item" style={`--i:${i}`}>
          <span class="stats-band__icon" aria-hidden="true"><Icon name={s.icon} size={20} strokeWidth={1.6} /></span>
          <strong class="stats-band__num" data-count={s.count}>{fmt(s.count)}</strong>
          <span class="stats-band__label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #E9F5EE;
    background:
      radial-gradient(1000px 320px at 50% -90%, rgba(15, 122, 74, 0.26), transparent 72%),
      linear-gradient(135deg, #07331f 0%, #094027 46%, #041f15 100%);
    padding-block: clamp(30px, 4.6vw, 56px);
    border-bottom: 1px solid rgba(201, 162, 39, 0.28);
    box-shadow: inset 0 36px 62px -46px rgba(0, 0, 0, 0.9);
  }
  .stats-band::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-gold), #7FE0AD, var(--color-gold), transparent);
    opacity: 0.75;
  }

  .stats-band__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stats-band__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding-inline: clamp(10px, 2vw, 26px);
  }
  .stats-band__item + .stats-band__item::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  }
  .stats-band__icon {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 999px;
    color: #D6EBDD;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(214, 235, 221, 0.26);
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .stats-band__item:hover .stats-band__icon {
    color: var(--color-gold);
    border-color: rgba(201, 162, 39, 0.55);
  }
  .stats-band__num {
    font-family: var(--font-num);
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .stats-band__label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: rgba(233, 245, 238, 0.72);
  }

  @media (max-width: 760px) {
    .stats-band {
      padding-block: 22px;
    }
    .stats-band__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats-band__item {
      gap: 6px;
      padding-inline: 3px;
    }
    .stats-band__item + .stats-band__item::before {
      top: 16%;
      bottom: 16%;
    }
    .stats-band__icon {
      inline-size: 32px;
      block-size: 32px;
      border-radius: 999px;
    }
    .stats-band__icon :global(svg) {
      inline-size: 15px;
      block-size: 15px;
    }
    .stats-band__num {
      font-size: clamp(1.05rem, 5.4vw, 1.7rem);
    }
    .stats-band__label {
      font-size: 0.66rem;
      line-height: 1.3;
    }
  }
</style>

<script>
  (() => {
    const nums = document.querySelectorAll<HTMLElement>('.stats-band [data-count]');
    if (!nums.length) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fmt = (v: number) => Math.round(v).toLocaleString('en-US');

    const run = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.count || '0');
      if (reduce) {
        el.textContent = fmt(target);
        return;
      }
      const duration = 1300;
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    if (!('IntersectionObserver' in window)) {
      nums.forEach(run);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    nums.forEach((n) => io.observe(n));
  })();
</script>
