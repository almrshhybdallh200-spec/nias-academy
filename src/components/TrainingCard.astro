---
import Icon from './Icon.astro';
import type { TrainingCourse } from '../lib/types';
import { mediaOf } from '../lib/data';

interface Props {
  course: TrainingCourse;
  showMeta?: boolean;
}

const { course, showMeta = true } = Astro.props;
---

<a class="training-card" href={`/training/${course.slug}`}>
  <div class="training-card__media">
    <img class="training-card__img" src={mediaOf(course.image)} alt={course.title} loading="lazy" decoding="async" />
    <span class="training-card__code">{course.code}</span>
  </div>
  <div class="training-card__body">
    <span class="training-card__cat">{course.category}</span>
    <h3>{course.title}</h3>
    {course.summary && <p class="training-card__summary">{course.summary}</p>}
    {showMeta && (
      <ul class="training-card__meta">
        <li><Icon name="clock" size={14} /> {course.duration}</li>
        <li><Icon name="book" size={14} /> {course.hours} ساعات</li>
        {course.mode && <li><Icon name="globe" size={14} /> {course.mode}</li>}
      </ul>
    )}
  </div>
</a>

<style>
  .training-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .training-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 16px 34px rgba(7, 123, 67, 0.12);
  }
  .training-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-primary-light), #e9f4ee);
  }
  .training-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .training-card:hover .training-card__img {
    transform: scale(1.05);
  }
  .training-card__code {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    font-family: var(--font-num);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(15, 122, 74, 0.28);
    padding: 2px 9px;
    border-radius: 8px;
  }
  .training-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--spacing-4);
    position: relative;
    flex: 1;
  }
  .training-card__cat {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-primary);
    background: var(--color-primary-light);
    border: 1px solid var(--color-border);
    padding: 2px 10px;
    border-radius: 999px;
  }
  .training-card h3 {
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1.6;
    color: var(--color-text);
  }
  .training-card__summary {
    font-size: 0.84rem;
    line-height: 1.9;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .training-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: auto;
    padding-top: var(--spacing-3);
    border-top: 1px dashed var(--color-border);
  }
  .training-card__meta li {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .training-card__meta svg {
    color: var(--color-primary);
  }
</style>