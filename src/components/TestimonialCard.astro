---
import Icon from './Icon.astro';
import { getBranch } from '../lib/data';

interface Props {
  name: string;
  role: string;
  workingAt: string;
  quote: string;
  branch: string;
  image?: string;
}

const { name, role, workingAt, quote, branch, image = '' } = Astro.props;
const branchName = getBranch(branch)?.name ?? '';
const initials = name
  .split(/[\s.]+/)
  .filter((w) => w && !['أ', 'د', 'أد', 'أ.د'].includes(w))
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
---

<figure class="testimonial">
  <div class="testimonial__media">
    {image ? (
      <img class="testimonial__img" src={image} alt={name} loading="lazy" decoding="async" />
    ) : (
      <span class="testimonial__avatar" aria-hidden="true">{initials}</span>
    )}
    <span class="testimonial__quote-mark" aria-hidden="true">
      <Icon name="quote" size={48} />
    </span>
    <span class="testimonial__stars" aria-hidden="true">
      {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={13} />)}
    </span>
  </div>

  <div class="testimonial__body">
    <blockquote>“{quote}”</blockquote>
    <figcaption class="testimonial__meta">
      <span class="testimonial__name">{name}</span>
      <span class="testimonial__role">{role} · {workingAt}</span>
      {branchName && (
        <span class="testimonial__branch">
          <Icon name="map-pin" size={12} />
          {branchName}
        </span>
      )}
    </figcaption>
  </div>
</figure>

<style>
  .testimonial {
    --tac: var(--color-accent);
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .testimonial:nth-child(1) { --tac: var(--color-accent); }
  .testimonial:nth-child(2) { --tac: var(--color-primary); }
  .testimonial:nth-child(3) { --tac: var(--color-secondary); }
  .testimonial:hover {
    transform: translateY(-6px);
    border-color: var(--tac);
    box-shadow: 0 26px 54px rgba(27, 30, 39, 0.12);
  }

  /* الصورة في الأعلى */
  .testimonial__media {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 168px;
    aspect-ratio: 16 / 8;
    background:
      radial-gradient(360px 200px at 80% -20%, color-mix(in srgb, var(--tac) 30%, transparent), transparent 70%),
      linear-gradient(150deg, color-mix(in srgb, var(--tac) 88%, #04381f), color-mix(in srgb, var(--tac) 52%, #0a5b34));
    overflow: hidden;
  }
  .testimonial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .testimonial__avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #fff;
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08));
    border: 2px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 12px 26px rgba(4, 26, 17, 0.3);
  }
  .testimonial__quote-mark {
    position: absolute;
    top: 6px;
    inset-inline-end: 12px;
    color: rgba(255, 255, 255, 0.28);
    z-index: 1;
  }
  .testimonial__stars {
    position: absolute;
    bottom: 10px;
    inset-inline-start: 14px;
    display: inline-flex;
    gap: 2px;
    color: #ffe08a;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.25));
  }

  /* النص في الأسفل */
  .testimonial__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: var(--spacing-4) var(--spacing-5) var(--spacing-5);
    flex: 1;
  }
  .testimonial blockquote {
    color: var(--color-text-secondary);
    font-size: 0.93rem;
    line-height: 1.95;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px dashed var(--color-border);
    padding-top: var(--spacing-3);
  }
  .testimonial__name {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary-dark);
  }
  .testimonial__role {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .testimonial__branch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--tac);
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial {
      transition: none;
    }
  }
</style>
