---
import { mediaOf } from '../lib/data';

interface Props {
  slug: string;
  name: string;
  description: string;
  icon: string;
  image?: string;
  index?: number;
}

const { slug, name, image = '', index = 0 } = Astro.props;
---

<a class="college-card" href={`/colleges/${slug}`} data-spotlight>
  <div class="college-card__media">
    <img class="college-card__img" src={mediaOf(image)} alt={name} loading="lazy" decoding="async" />
    <span class="college-card__num" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  </div>
  <div class="college-card__body">
    <h3>{name}</h3>
  </div>
</a>

<style>
  .college-card {
    --cc: var(--color-primary);
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    border-radius: 16px;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .college-card:nth-child(1) { --cc: var(--color-gold); }
  .college-card:nth-child(2) { --cc: var(--color-primary); }
  .college-card:nth-child(3) { --cc: var(--color-secondary); }

  .college-card__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-primary-light), #e9f4ee);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .college-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .college-card:hover {
    transform: translateY(-4px);
    border-color: var(--cc);
    box-shadow: 0 18px 38px rgba(27, 30, 39, 0.12);
  }
  .college-card:hover .college-card__img {
    transform: scale(1.05);
  }
  .college-card__num {
    position: absolute;
    inset-inline-end: 10px;
    top: 4px;
    font-family: var(--font-num);
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 10px rgba(8, 61, 37, 0.45);
    z-index: 1;
  }

  .college-card__body {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: var(--spacing-4) var(--spacing-4) var(--spacing-3) var(--spacing-3);
  }
  .college-card h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.4;
    color: var(--color-primary-dark);
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .college-card,
    .college-card__img {
      transition: none;
    }
  }
</style>