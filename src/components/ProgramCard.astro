---
import type { Program } from '../lib/types';
import { mediaOf } from '../lib/data';

interface Props {
  program: Program;
}

const { program } = Astro.props;
const isProfessional = program.type === 'diploma';
---

<article class:list={['program-card', isProfessional && 'program-card--prof']}>
  <a class="program-card__media" href={`/media/programs/${program.slug}`} aria-label={program.name}>
    <img class="program-card__img" src={mediaOf(program.image)} alt={program.name} loading="lazy" decoding="async" />
    <span class="program-card__type">{program.typeLabel}</span>
  </a>
  <div class="program-card__body">
    <h3 class="program-card__title">
      <a href={`/media/programs/${program.slug}`}>{program.name}</a>
    </h3>
  </div>
</article>

<style>
  .program-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .program-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 14px 30px rgba(27, 30, 39, 0.1);
  }

  .program-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-primary-light), #e9f4ee);
  }
  .program-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .program-card:hover .program-card__img {
    transform: scale(1.05);
  }
  .program-card__type {
    position: absolute;
    top: 10px;
    inset-inline-start: 10px;
    font-size: 0.7rem;
    font-weight: 800;
    color: #fff;
    background: rgba(8, 61, 37, 0.82);
    backdrop-filter: blur(2px);
    padding: 3px 11px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .program-card.program-card--prof .program-card__type {
    background: rgba(21, 145, 179, 0.85);
  }

  .program-card__body {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: var(--spacing-3) var(--spacing-3);
  }
  .program-card__title {
    font-size: 0.9rem;
    font-weight: 900;
    line-height: 1.5;
    color: var(--color-text);
    flex: 1;
  }
  .program-card__title a:hover {
    color: var(--color-primary);
  }
</style>