<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track) return;

    const step = () => {
      const first = track.querySelector<HTMLElement>('.dsx-slide');
      return first ? first.offsetWidth + 16 : track.clientWidth;
    };
    const rtlSign = getComputedStyle(track).direction === 'rtl' ? -1 : 1;

    prev?.addEventListener('click', () => {
      track.scrollBy({ left: -step() * rtlSign, behavior: prefersReduced.matches ? 'auto' : 'smooth' });
    });
    next?.addEventListener('click', () => {
      track.scrollBy({ left: step() * rtlSign, behavior: prefersReduced.matches ? 'auto' : 'smooth' });
    });
  });

  const jumpLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-jump]'));
  const sections = jumpLinks
    .map((link) => document.getElementById(link.getAttribute('href')!.slice(1)))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          jumpLinks.forEach((link) => {
            const active = link.getAttribute('href') === `#${id}`;
            if (active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-96px 0px -60% 0px', threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
  }

  if (!prefersReduced.matches && window.matchMedia('(pointer: fine)').matches) {
    document.documentElement.classList.add('js');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
