          const el = entry.target as HTMLElement;
          el.classList.add('in');
          if (el.hasAttribute('data-count')) {
            const target = parseFloat(el.dataset.count || '0');
            const duration = 1200;
            const start = performance.now();
            const format = (v: number) =>
              String(Math.round(v)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            const step = (now: number) => {
              const p = Math.min((now - start) / duration, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = format(target * eased);
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
          revealObserver.unobserve(el);
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => revealObserver.observe(el));

    const heroLayer = document.querySelector<HTMLElement>('[data-parallax]');
    if (heroLayer) {
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const y = window.scrollY;
              if (y < window.innerHeight) {
                heroLayer.style.transform = `translateY(${y * 0.12}px)`;
              } else {
                heroLayer.style.transform = ``;
              }
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true },
      );
    }

    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const strength = Number(el.dataset.tilt ?? 6);
      el.addEventListener('pointermove', (e) => {
        const rect = el.getBoundingClientRect();
        const rx = ((e.clientY - rect.top) / rect.height - 0.5) * -2 * strength;
        const ry = ((e.clientX - rect.left) / rect.width - 0.5) * 2 * strength;
        el.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-2px)`;
      });
      el.addEventListener('pointerleave', () => {
        el.style.transform = '';
      });
    });
  }
</script>