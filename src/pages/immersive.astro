---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { toArabicNumerals, formatDate } from '../lib/format';
import {
  siteConfig,
  branches,
  colleges,
  programs,
  newsItems,
  announcements,
  partners,
  eServices,
  trainingCourses,
  getLatest,
} from '../lib/data';

const latestNews = getLatest(newsItems, 8);
const homeStats = [
  { value: siteConfig.stats.years, label: 'عامًا من العطاء' },
  { value: siteConfig.stats.graduates, label: 'خريج شهادة' },
  { value: siteConfig.stats.trainees, label: 'متدرب وملتحق' },
  { value: siteConfig.stats.branches, label: 'فروع في اليمن' },
];
const services = eServices.slice(0, 6);
const gradPrograms = programs.filter((p) => p.typeLabel === 'دبلوم عالي').slice(0, 3);
const profPrograms = programs.filter((p) => p.typeLabel !== 'دبلوم عالي').slice(0, 3);
const trainings = trainingCourses.slice(0, 3);
const latestAnnouncements = announcements.slice(0, 3);

const navItems = [
  { id: 'path', label: 'ابدأ من هنا' },
  { id: 'services', label: 'الخدمات' },
  { id: 'programs', label: 'البرامج' },
  { id: 'colleges', label: 'الكليات' },
  { id: 'media', label: 'الأخبار' },
  { id: 'faq', label: 'الأسئلة' },
];

const audiences = [
  { icon: 'graduation', title: 'طالب / متقدّم', text: 'التسجيل والملفات والنتائج الأكاديمية.', href: '/portal', cta: 'البوابة الأكاديمية' },
  { icon: 'user', title: 'موظف حكومي', text: 'الدورات التخصصية وشؤون الموظفين.', href: '/training', cta: 'تصفّح التدريب' },
  { icon: 'university', title: 'جهة / مؤسسة', text: 'برامج بناء القدرات والاستشارات.', href: '/about', cta: 'اطلب شراكة' },
  { icon: 'book', title: 'باحث / أكاديمي', text: 'المكتبة الرقمية والأبحاث الإدارية.', href: '/about#library', cta: 'المكتبة الرقمية' },
];

const faqs = [
  { q: 'هل الحركات تُبطئ الموقع؟', a: 'لا؛ كل الانتقالات والـ 3D تعمل على transform/opacity فقط وتتوقف عند prefers-reduced-motion، والمحتوى يظهر ساكنًا حتى بدون JavaScript.' },
  { q: 'هل الـ 3D مدعوم في كل المتصفحات؟', a: 'نعم؛ يعتمد على CSS perspective وpreserve-3d مع خفض تدريجي أنيق، ويُعطَّل على الأجهزة اللمسية وعند تقليل الحركة.' },
  { q: 'ما شروط الالتحاق ببرامج الدبلوم العالي؟', a: 'مؤهل بكالوريوس، وخبرة لا تقل عن سنتين في الوظيفة العامة، واجتياز المقابلة الشخصية.' },
  { q: 'هل الدراسة صباحية أم مسائية؟', a: 'تتوفر أوضاع متعددة: صباحي، مسائي، وتنفيذي في نهاية الأسبوع بحسب البرنامج.' },
  { q: 'هل يقدّم المعهد برامج للجهات والمؤسسات؟', a: 'نعم، برامج بناء قدرات واستشارات مخصّصة للقطاعين العام والخاص عبر فروع المعهد السبعة.' },
];

const designSystem = [
  { n: '01', c: 'Accessibility · CRITICAL', d: 'رابط تخطٍّ، حلقة تركيز 3px، تباين ≥ 4.5:1، أيقونات زخرفية مخفية، وكل الحركات تُلغى عند reduces-motion.' },
  { n: '02', c: 'Touch & Interaction · CRITICAL', d: 'أهداف ≥ 44px، تباعد ≥ 8px، حالات pressed/hover/focus، وتيلت ثلاثي الأبعاد يعمل بالفأرة ويُهمَل باللمس.' },
  { n: '03', c: 'Performance · HIGH', d: 'JS صفري ما لم يُفعَّل، كل الحركة على compositor (transform/opacity)، صور lazy، حجز الأبعاد ضد CLS.' },
  { n: '04', c: 'Style Selection · HIGH', d: 'Swiss/Minimal/Flat موحّد بلا إيموجي، مع طبقة Depth ثلاثية الأبعاد هادئة لا تكسر النمط.' },
  { n: '05', c: 'Layout & Responsive · HIGH', d: 'Mobile-first، نقاط توقف 640/960/1024، بلا تمرير أفقي، حدّ قراءة ≤ 68ch.' },
  { n: '06', c: 'Typography & Color · MEDIUM', d: 'أساس 16px، line-height 1.8، text-wrap: balance، ورموز دلالية عبر CSS variables.' },
  { n: '07', c: 'Transitions · MEDIUM/HIGH', d: 'دخول متدرّج (fade+rise)، Stagger للبطاقات، Parallax خفيف للهيرو، عدّادات أرقام، كلها بمدد 200–500ms.' },
  { n: '08', c: '3D Effects · MEDIUM', d: 'منظور perspective، تيلت rotateX/rotateY، عمق translateZ للعناصر الداخلية، وإيقاف تلقائي عند reduced-motion.' },
  { n: '09', c: 'Navigation Patterns · HIGH', d: 'تنقّل مرساة مع scroll-spy وaria-current، scroll-padding-top، روابط عميقة لكل قسم.' },
  { n: '10', c: 'Forms & Feedback · MEDIUM', d: 'إفصاح تدريجي بأكوام <details>، وتغذية راجعة فورية لكل تفاعل.' },
];
---

<BaseLayout
  title={`رؤية الموقع — انتقالات وثلاثية الأبعاد · ${siteConfig.name}`}
  description="صفحة رؤية تجريبية تطبّق كل مهارات UI UX Pro Max: أنماط، انتقالات متدرّجة، Parallax، وبطاقات ثلاثية الأبعاد."
>
  <a class="dsx-skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>

  <div class="dsx">
    <div class="dsx-note" role="note">
      <div class="container dsx-note__inner">
        <span class="dsx-note__badge">رؤية</span>
        <span>صفحة تعرض <strong>كل التصاميم + الانتقالات + الـ 3D</strong> — حرّك الفأرة فوق البطاقات ومرّر الصفحة.</span>
        <a class="dsx-note__link" href="/">موقع المعهد الأصلي <Icon name="arrow-left" size={14} /></a>
      </div>
    </div>

    <main id="main">
      <header class="dsx-hero">
        <div class="container dsx-hero__grid">
          <div class="dsx-hero__body">
            <p class="dsx-kicker" data-reveal>المعهد الوطني للعلوم الإدارية · منذ {toArabicNumerals(siteConfig.established)}</p>
            <h1 data-reveal style="--d:80ms">{siteConfig.tagline}</h1>
            <p class="dsx-lead" data-reveal style="--d:160ms">{siteConfig.footerDescription}</p>
            <div class="dsx-actions" data-reveal style="--d:240ms">
              <a class="dsx-btn dsx-btn--solid" href={siteConfig.dates.registrationLink}>
                سجّل الآن
                <Icon name="arrow-left" size={18} />
              </a>
              <a class="dsx-btn dsx-btn--line" href="#programs">استكشف البرامج</a>
            </div>
            <p class="dsx-hero__trust" data-reveal style="--d:320ms">
              <Icon name="shield" size={16} />
              معتمد من وزارة الخدمة المدنية والتأمينات · تسجيل الدفعة {siteConfig.dates.academicYear}
            </p>
            <dl class="dsx-stats" data-reveal style="--d:400ms">
              {homeStats.map((s) => (
                <div>
                  <dt>{toArabicNumerals(s.value)}</dt>
                  <dd>{s.label}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="dsx-hero__aside" data-reveal style="--d:200ms">
            <figure class="dsx-hero__media" data-parallax data-tilt data-tilt="4">
              <img src="/images/headquarters2.jpg" alt="مقر المعهد الوطني للعلوم الإدارية — صنعاء" loading="lazy" decoding="async" />
            </figure>
            <div class="dsx-cred" data-tilt data-tilt="8">
              <span class="dsx-cred__ic"><Icon name="award" size={20} /></span>
              <div>
                <strong>اعتماد رسمي</strong>
                <span>مؤسسة وطنية لبناء القدرات الإدارية</span>
              </div>
            </div>
          </div>
        </div>
      </header>

      <nav class="dsx-jump" aria-label="أقسام الصفحة">
        <div class="container dsx-jump__inner">
          {navItems.map((n) => (
            <a class="dsx-jump__link" href={`#${n.id}`} data-jump>
              {n.label}
            </a>
          ))}
        </div>
      </nav>

      <section class="dsx-section" id="path">
        <div class="container">
          <div class="dsx-head" data-reveal>
            <span class="dsx-num">01</span>
            <div>
              <h2>ابدأ من هنا</h2>
              <p>اختر هويتك لتصلك الخدمة المناسبة مباشرة — البطاقات ثلاثية الأبعاد تتبع الفأرة.</p>
            </div>
          </div>
          <div class="dsx-grid dsx-grid--paths">
            {audiences.map((a, i) => (
              <a class="dsx-path" href={a.href} data-tilt data-reveal style={`--d:${i * 90}ms`}>
                <span class="dsx-path__ic"><Icon name={a.icon} size={24} /></span>
                <strong>{a.title}</strong>
                <small>{a.text}</small>
                <span class="dsx-path__cta">
                  {a.cta}
                  <Icon name="arrow-left" size={15} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="services">
        <div class="container">
          <div class="dsx-head" data-reveal>
            <span class="dsx-num">02</span>
            <div>
              <h2>الخدمات الإلكترونية</h2>
              <p>شبكة Bento حديثة — تظهر البطاقات متدرّجة عند التمرير.</p>
            </div>
          </div>
          <div class="dsx-bento">
            {services.map((s, i) => (
              <a
                class:list={['dsx-tile', i < 2 && 'dsx-tile--feature']}
                href={s.href}
                data-tilt
                data-tilt={i < 2 ? '5' : '4'}
                data-reveal
                style={`--d:${i * 80}ms`}
              >
                <span class="dsx-tile__ic"><Icon name={s.icon} size={26} /></span>
                <strong>{s.name}</strong>
                <small>{s.description}</small>
                <span class="dsx-tile__go"><Icon name="arrow-left" size={16} /></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-band" data-reveal aria-label="أرقام المعهد">
        <div class="container dsx-band__grid">
          {homeStats.map((s) => (
            <div>
              <strong data-count={s.value}>{toArabicNumerals(s.value)}</strong>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="dsx-section" id="programs">
        <div class="container">
          <div class="dsx-head" data-reveal>
            <span class="dsx-num">03</span>
            <div>
              <h2>البرامج الأكاديمية</h2>
              <p>مسار متدرّج: دبلومات عالية ثم دبلومات مهنية.</p>
            </div>
          </div>

          <h3 class="dsx-sub" data-reveal>دبلومات عالية</h3>
          <div class="dsx-grid dsx-grid--prog">
            {gradPrograms.map((p, i) => (
              <article class="dsx-pcard" data-reveal style={`--d:${i * 90}ms`}>
                <span class="dsx-pcard__tag">{p.typeLabel}</span>
                <h4>{p.name}</h4>
                <p>{p.overview}</p>
                <ul>
                  <li><Icon name="clock" size={14} />{p.duration}</li>
                  <li><Icon name="book" size={14} />{toArabicNumerals(p.hours)} ساعة</li>
                  <li><Icon name="layers" size={14} />{p.mode}</li>
                </ul>
                <a class="dsx-pcard__more" href={`/media/programs/${p.slug}`}>
                  التفاصيل
                  <Icon name="arrow-left" size={15} />
                </a>
              </article>
            ))}
          </div>

          <h3 class="dsx-sub" data-reveal>دبلومات مهنية</h3>
          <div class="dsx-grid dsx-grid--prog">
            {profPrograms.map((p, i) => (
              <article class="dsx-pcard" data-reveal style={`--d:${i * 90}ms`}>
                <span class="dsx-pcard__tag">{p.typeLabel}</span>
                <h4>{p.name}</h4>
                <p>{p.overview}</p>
                <ul>
                  <li><Icon name="clock" size={14} />{p.duration}</li>
                  <li><Icon name="book" size={14} />{toArabicNumerals(p.hours)} ساعة</li>
                  <li><Icon name="layers" size={14} />{p.mode}</li>
                </ul>
                <a class="dsx-pcard__more" href={`/media/programs/${p.slug}`}>
                  التفاصيل
                  <Icon name="arrow-left" size={15} />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="colleges">
        <div class="container">
          <div class="dsx-head" data-reveal>
            <span class="dsx-num">04</span>
            <div>
              <h2>الكليات</h2>
              <p>ثلاث كليات تغطي الإدارة العامة والمالية والمعلوماتية.</p>
            </div>
          </div>
          <div class="dsx-grid dsx-grid--colleges">
            {colleges.map((c, i) => (
              <a class="dsx-ccard" href={`/colleges/${c.slug}`} data-tilt data-reveal style={`--d:${i * 100}ms`}>
                <span class="dsx-ccard__ic"><Icon name={c.icon} size={24} /></span>
                <strong>{c.name}</strong>
                <small>{c.description}</small>
                <ul>
                  {c.goals.map((g) => (
                    <li>{g}</li>
                  ))}
                </ul>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section" id="media">
        <div class="container">
          <div class="dsx-carousel" data-reveal data-carousel aria-roledescription="carousel" aria-label="آخر الأخبار">
            <div class="dsx-carousel__head">
              <div class="dsx-head dsx-head--sm">
                <span class="dsx-num">05</span>
                <div><h2>آخر الأخبار</h2></div>
              </div>
              <div class="dsx-carousel__ctrls">
                <button type="button" class="dsx-round" data-carousel-prev aria-label="الخبر السابق">
                  <Icon name="chevron-right" size={18} />
                </button>
                <button type="button" class="dsx-round" data-carousel-next aria-label="الخبر التالي">
                  <Icon name="chevron-left" size={18} />
                </button>
              </div>
            </div>
            <ul class="dsx-carousel__track" data-carousel-track tabindex="0" aria-label="قائمة الأخبار — استخدم الأسهم للتنقل">
              {latestNews.map((n, i) => (
                <li class="dsx-slide" aria-label={`${toArabicNumerals(i + 1)} من ${toArabicNumerals(latestNews.length)}`}>
                  <a href={`/media/news/${n.slug}`}>
                    <span class="dsx-slide__cat">{n.category}</span>
                    <strong>{n.title}</strong>
                    <time>{formatDate(n.date)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="dsx-ann-wrap" data-reveal style="--d:150ms">
            <div class="dsx-head dsx-head--sm">
              <span class="dsx-num">06</span>
              <div><h2>إعلانات</h2></div>
            </div>
            <ul class="dsx-ann">
              {latestAnnouncements.map((a) => (
                <li>
                  <span>{a.code}</span>
                  <strong>{a.title}</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="dsx-trust" data-reveal aria-label="جهات تثق بالمعهد">
        <div class="container">
          <p class="dsx-trust__label">جهات تثق بالمعهد</p>
          <ul class="dsx-trust__list">
            {partners.map((p) => (
              <li><Icon name="landmark" size={14} />{p.name}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="faq">
        <div class="container dsx-faq-wrap">
          <div class="dsx-head" data-reveal>
            <span class="dsx-num">07</span>
            <div>
              <h2>الأسئلة الشائعة</h2>
              <p>إفصاح تدريجي عبر <code>&lt;details&gt;</code> أصلي يعمل دون JavaScript.</p>
            </div>
          </div>
          <div class="dsx-faq">
            {faqs.map((f, i) => (
              <details class="dsx-faq__item" data-reveal style={`--d:${i * 70}ms`}>
                <summary>
                  <span>{f.q}</span>
                  <Icon name="chevron-down" size={18} />
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-cta">
        <div class="container dsx-cta__inner">
          <div data-reveal>
            <h2>انضم إلى أكثر من {toArabicNumerals(siteConfig.stats.graduates)} خريج</h2>
            <p>تسجيل الدفعة {siteConfig.dates.academicYear} مستمر حتى {formatDate(siteConfig.dates.applicationDeadline)}.</p>
          </div>
          <div class="dsx-cta__actions" data-reveal style="--d:150ms">
            <a class="dsx-btn dsx-btn--gold" href={siteConfig.dates.registrationLink}>
              سجّل الآن
              <Icon name="arrow-left" size={18} />
            </a>
            <a class="dsx-btn dsx-btn--outline" href="/contact">تواصل معنا</a>
          </div>
        </div>
      </section>

      <section class="dsx-section" aria-label="نظام التصميم المطبّق">
        <div class="container">
          <h2 class="dsx-ds__title" data-reveal>نظام التصميم المطبّق <span>UI UX Pro Max</span></h2>
          <ul class="dsx-ds__grid">
            {designSystem.map((r, i) => (
              <li data-reveal style={`--d:${i * 60}ms`}>
                <span class="dsx-ds__n">{r.n}</span>
                <strong>{r.c}</strong>
                <p>{r.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  .dsx {
    --g: #0F7A4A;
    --g-d: #0A5C37;
    --g-l: #E4F1E9;
    --ink: #101418;
    --navy: #26304D;
    --gold: #C9A227;
    --bg: #FBFAF7;
    --surf: #ffffff;
    --muted: #5B6470;
    --line: #E4E4DE;
    --focus: #1591B3;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--bg);
    color: var(--ink);
  }

  .dsx-skip {
    position: absolute;
    inset-inline-start: 12px;
    top: -56px;
    z-index: 100;
    background: var(--g-d);
    color: #fff;
    font-weight: 800;
    padding: 12px 18px;
    border-radius: 8px;
    transition: top 0.15s ease;
  }
  .dsx-skip:focus {
    top: 12px;
  }

  .dsx-note {
    background: var(--navy);
    color: #fff;
  }
  .dsx-note__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 10px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .dsx-note__badge {
    background: var(--gold);
    color: #1B1405;
    font-weight: 800;
    font-size: 0.72rem;
    padding: 3px 12px;
    border-radius: 999px;
  }
  .dsx-note__link {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-weight: 700;
    min-height: 32px;
  }
  .dsx-note__link:hover {
    text-decoration: underline;
  }

  .dsx-kicker {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--g-d);
  }
  .dsx h1,
  .dsx h2 {
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .dsx-hero {
    border-bottom: 1px solid var(--line);
    background: var(--surf);
    overflow: hidden;
  }
  .dsx-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    padding-block: 72px;
  }
  .dsx-hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin-top: 14px;
    text-wrap: balance;
    max-inline-size: 18ch;
  }
  .dsx-lead {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.9;
    margin-top: 18px;
    max-width: 58ch;
  }
  .dsx-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .dsx-hero__trust {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--g-d);
    background: var(--g-l);
