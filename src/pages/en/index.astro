---
import '../../styles/global.css';
import { siteConfig } from '../../lib/data';

const highlights = [
  { icon: 'graduation', title: 'Accredited diplomas', text: 'Higher, professional and specialized programs across administration, finance and technology.' },
  { icon: 'users', title: 'Expert trainers', text: 'Practitioners and academics with real-world experience in public and private sectors.' },
  { icon: 'map-pin', title: 'Nationwide presence', text: `${siteConfig.stats.branches} branches serving learners across Yemen.` },
  { icon: 'qrcode', title: 'Verifiable certificates', text: 'Every certificate is documented and verifiable online.' },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NIAS — National Institute of Administrative Sciences</title>
    <meta name="description" content="The National Institute of Administrative Sciences — Yemen's national house of administrative training, development and consultancy since 1963." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/fonts/fonts.css?v=5" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/tajawal-latin-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/tajawal-latin-700.woff2" crossorigin />
  </head>
  <body class="en-page">
    <header class="en-nav">
      <a class="en-brand" href="/en/">
        <img src="/logo.png" width="44" height="44" alt="NIAS logo" />
        <span>
          <strong>NIAS</strong>
          <small>National Institute of Administrative Sciences</small>
        </span>
      </a>
      <a class="en-lang" href="/">
        <span lang="ar">العربية</span>
      </a>
    </header>

    <main>
      <section class="en-hero">
        <div class="en-wrap">
          <span class="en-badge">Since {siteConfig.established}</span>
          <h1>Building Yemen's administrative leaders</h1>
          <p>
            The National Institute of Administrative Sciences is Yemen's national house of
            administrative training and consultancy — offering accredited diplomas, professional
            programs and specialized courses for the public and private sectors.
          </p>
          <div class="en-cta">
            <a class="en-btn en-btn--primary" href="/portal">Access the student portal</a>
            <a class="en-btn" href="/media/programs">Explore programs</a>
          </div>
        </div>
      </section>

      <section class="en-wrap en-grid">
        {highlights.map((h) => (
          <article class="en-card">
            <span class="en-card__ic" aria-hidden="true">{h.title.charAt(0)}</span>
            <h2>{h.title}</h2>
            <p>{h.text}</p>
          </article>
        ))}
      </section>

      <section class="en-wrap en-note">
        <p>
          The full website is currently available in Arabic. For detailed information, please switch
          to the Arabic version.
        </p>
        <a class="en-btn en-btn--primary" href="/">Go to Arabic site</a>
      </section>
    </main>

    <footer class="en-footer">
      <div class="en-wrap">
        <p>© {siteConfig.established}–{new Date().getFullYear()} NIAS. All rights reserved.</p>
        <p>Developed by Abdullah Qaid Al-Marshhi</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(body.en-page) {
    font-family: var(--font-body);
    background: var(--color-background);
    color: var(--color-text);
    margin: 0;
  }
  .en-wrap {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  .en-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .en-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .en-brand img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--color-primary-light);
  }
  .en-brand strong {
    display: block;
    font-size: 1rem;
    color: var(--color-primary);
  }
  .en-brand small {
    display: block;
    font-size: 11px;
    color: var(--color-text-muted);
  }
  .en-lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 10px;
    font-weight: 800;
    font-size: 13px;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }
  .en-lang:hover {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  .en-hero {
    padding: 72px 0 48px;
    background:
      radial-gradient(700px 320px at 88% -20%, rgba(212, 175, 55, 0.28), transparent 60%),
      radial-gradient(620px 300px at 2% 120%, rgba(46, 181, 122, 0.3), transparent 60%),
      linear-gradient(120deg, #0E4330 0%, #12503A 55%, #0A3625 100%);
    color: #fff;
  }
  .en-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #F3D98B;
    background: rgba(212, 175, 55, 0.16);
    border: 1px solid rgba(212, 175, 55, 0.5);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .en-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.2;
    margin: 18px 0 14px;
    max-width: 20ch;
  }
  .en-hero p {
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.85);
  }
  .en-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .en-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.94rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.28);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .en-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }
  .en-btn--primary {
    background: linear-gradient(120deg, var(--color-gold), #E9C15C);
    color: #2A1F00;
    border-color: transparent;
  }
  .en-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    padding-block: 56px;
  }
  .en-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 26px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .en-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 16px 34px rgba(15, 122, 74, 0.12);
  }
  .en-card__ic {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font-weight: 900;
    font-size: 1.2rem;
    margin-bottom: 14px;
  }
  .en-card h2 {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 900;
    color: var(--color-primary-dark);
    margin-bottom: 6px;
  }
  .en-card p {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }
  .en-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-primary-light);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 26px;
    margin-bottom: 56px;
  }
  .en-note p {
    max-width: 60ch;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  .en-note .en-btn--primary {
    color: #fff;
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-dark));
  }
  .en-footer {
    background: #0A3625;
    color: rgba(255, 255, 255, 0.7);
    padding-block: 26px;
    font-size: 0.82rem;
  }
  .en-footer .en-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
</style>
