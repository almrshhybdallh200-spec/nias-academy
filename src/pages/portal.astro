---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import EServicesGrid from '../components/EServicesGrid.astro';
import Icon from '../components/Icon.astro';
import { eServices, siteConfig, programs } from '../lib/data';
import { formatDate, toArabicNumerals } from '../lib/format';

const openCount = programs.filter((p) => (p.status || '').includes('مفتوح')).length;
const deadlineText = formatDate(siteConfig.dates.applicationDeadline);
const moheUrl = 'https://oasyemen.net/';
const portalSteps = [
  { icon: 'university', title: 'سجّل في وزارة التعليم العالي', text: 'ابدأ بالتسجيل عبر بوابة التنسيق والقبول الإلكترونية الموحدة للحصول على رقم أكاديمي معتمد.', href: moheUrl },
  { icon: 'user', title: 'أنشئ حسابك في البوابة', text: 'أدخل رقمك الأكاديمي وكلمة المرور، ويصبح ملفك الأكاديمي متاحًا لك بالكامل.' },
  { icon: 'award', title: 'تابع دراستك بالكامل', text: 'الخطة الدراسية، الجداول، النتائج، والشهادات في مكان واحد.' },
];
const sideItems = [
  { icon: 'search-check', text: 'نتائج القبول ومتابعة الطلبات' },
  { icon: 'qrcode', text: 'شهادات موثقة قابلة للتحقق' },
  { icon: 'calendar', text: 'الخطة الدراسية والجداول' },
  { icon: 'library', text: 'مكتبة رقمية وأرشيف محدّث' },
];
---

<BaseLayout
  title="بوابة الطالب"
  description="بوابة الطالب للخدمات الإلكترونية — التسجيل، الاستعلامات، النتائج، الشهادات القابلة للتحقق، والمكتبة الرقمية في منصة واحدة."
  aiContext="بوابة الطالب"
  hideFooter
>
  <PageHero
    title="بوابة الطالب"
    subtitle="كل خدماتك الأكاديمية في منصة واحدة: تسجيل إلكتروني، متابعة فورية، نتائج، وشهادات موثقة قابلة للتحقق."
    crumbs={[{ label: 'الرئيسية', href: '/' }, { label: 'بوابة الطالب' }]}
  />

  <section class="section">
    <div class="container">
      <div class="portal-rip" data-reveal>
        <div class="portal-rip__cell">
          <span class="portal-rip__ic"><Icon name="calendar" size={18} /></span>
          <strong>{toArabicNumerals(siteConfig.dates.academicYear)}</strong>
          <small>الدفعة الحالية</small>
        </div>
        <div class="portal-rip__cell">
          <span class="portal-rip__ic"><Icon name="clock" size={18} /></span>
          <strong>{toArabicNumerals(deadlineText)}</strong>
          <small>الموعد النهائي للتسجيل</small>
        </div>
        <div class="portal-rip__cell">
          <span class="portal-rip__ic"><Icon name="layers" size={18} /></span>
          <strong>{toArabicNumerals(openCount)} / {toArabicNumerals(programs.length)}</strong>
          <small>برنامج مفتوح للتسجيل</small>
        </div>
      </div>

      <div class="portal-steps" data-reveal>
        <div class="portal-steps__head">
          <SectionHeader icon="target" title="تبدأ من هنا" subtitle="ثلاث خطوات تفصلك عن ملفك الأكاديمي وبرنامجك." />
          <a class="portal-steps__cta" href={moheUrl} target="_blank" rel="noopener">
            <Icon name="university" size={18} />
            <span>التسجيل عبر وزارة التعليم العالي</span>
            <Icon name="external" size={16} />
          </a>
        </div>
        <div class="portal-steps__grid">
          {portalSteps.map((s, i) => (
            <div class="portal-step">
              <span class="portal-step__num">{toArabicNumerals(i + 1)}</span>
              <span class="portal-step__ic"><Icon name={s.icon} size={22} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              {s.href && (
                <a class="portal-step__link" href={s.href} target="_blank" rel="noopener">
                  الانتقال إلى البوابة <Icon name="external" size={14} />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>


      <div class="auth" id="auth" data-portal data-reveal>
        <aside class="auth__side" aria-hidden="true">
          <span class="auth__side-badge">
            <Icon name="shield" size={14} />
            بوابة موثوقة وآمنة
          </span>
          <h3>ملفك الأكاديمي… في حساب واحد</h3>
          <p>بعد الدخول تستطيع إدارة بياناتك، متابعة طلباتك، والوصول لشهاداتك في أي وقت.</p>
          <ul class="auth__side-list">
            {sideItems.map((it) => (
              <li><Icon name={it.icon} size={17} /><span>{it.text}</span></li>
            ))}
          </ul>
        </aside>

        <div class="auth__stage">
          <p class="auth__msg" data-auth-msg role="status" aria-live="polite" hidden></p>

          <form class="auth__form" data-view="login" novalidate>
            <div class="auth__head">
              <h3>تسجيل الدخول</h3>
              <p>أدخل رقم البطاقة وكلمة المرور للوصول إلى ملفك الأكاديمي.</p>
            </div>
            <div class="auth__tabs" role="tablist" aria-label="نوع الحساب">
              <button type="button" class="auth__tab is-active" data-role="student" aria-selected="true">طالب</button>
              <button type="button" class="auth__tab" data-role="trainee" aria-selected="false">متدرب</button>
              <button type="button" class="auth__tab" data-role="staff" aria-selected="false">موظف</button>
            </div>
            <div class="auth__fields">
              <label class="auth__label">الرقم الأكاديمي أو رقم البطاقة
                <input type="text" data-pid autocomplete="username" placeholder="مثال: NIAS-2026-00125" />
              </label>
              <label class="auth__label">كلمة المرور
                <input type="password" data-pass autocomplete="current-password" placeholder="••••••••" />
              </label>
            </div>
            <div class="auth__row">
              <label class="auth__check"><input type="checkbox" data-remember checked /> تذكرني على هذا الجهاز</label>
              <button type="button" class="auth__link-btn" data-forgot>نسيت كلمة المرور؟</button>
            </div>
            <button type="submit" class="auth__submit">دخول إلى حسابي</button>
            <p class="auth__switch">ليس لديك حساب؟ <button type="button" class="auth__link-btn" data-to-register>إنشاء حساب جديد</button></p>
          </form>

          <form class="auth__form" data-view="register" hidden novalidate>
            <div class="auth__head">
              <h3>إنشاء حساب جديد</h3>
              <p>أنشئ حسابك للوصول إلى التقديم والاستعلامات والنتائج.</p>
            </div>
            <ol class="auth__flow">
              <li>
                <span class="auth__flow-num">١</span>
                <span>
                  <strong>سجّل في وزارة التعليم العالي</strong>
                  <small>التسجيل الأول يتم عبر بوابة التنسيق والقبول الإلكترونية الموحدة للحصول على رقم أكاديمي معتمد.</small>
                  <a class="auth__flow-link" href={moheUrl} target="_blank" rel="noopener">
                    الانتقال إلى بوابة الوزارة <Icon name="external" size={13} />
                  </a>
                </span>
              </li>
              <li>
                <span class="auth__flow-num">٢</span>
                <span>
                  <strong>أدخل رقمك الأكاديمي هنا</strong>
                  <small>يستخدم الرقم الأكاديمي للتحقق من بياناتك وربطها بسجلك الأكاديمي.</small>
                </span>
              </li>
              <li>
                <span class="auth__flow-num">٣</span>
                <span>
                  <strong>أكمل حسابك</strong>
                  <small>تحدّد كلمة المرور، وستتمكّن من الخطة الدراسية والجداول والنتائج.</small>
                </span>
              </li>
            </ol>
            <div class="auth__fields auth__fields--grid">
              <label class="auth__label">الاسم الكامل
                <input type="text" data-r-name placeholder="الاسم الثلاثي" />
              </label>
              <label class="auth__label">الرقم الأكاديمي
                <input type="text" data-r-pid placeholder="الرقم الأكاديمي من وزارة التعليم العالي" />
              </label>
              <label class="auth__label">رقم الهاتف
                <input type="tel" data-r-phone placeholder="7XXXXXXXX" dir="ltr" />
              </label>
              <label class="auth__label">كلمة المرور
                <input type="password" data-r-pass placeholder="6 أحرف على الأقل" />
              </label>
            </div>
            <button type="submit" class="auth__submit">إنشاء الحساب والدخول</button>
            <p class="auth__switch">لديك حساب؟ <button type="button" class="auth__link-btn" data-to-login>تسجيل الدخول</button></p>
          </form>

          <div class="auth__dash-note" data-login-hint>
            <Icon name="arrow-left" size={16} />
            بعد تسجيل الدخول ستنتقل تلقائيًا إلى لوحة التحكم.
          </div>
        </div>
      </div>

      <div id="services">
        <SectionHeader
          icon="briefcase"
          title="خدمات البوابة"
          subtitle={`${toArabicNumerals(eServices.length)} خدمة رقمية متاحة عبر بوابة واحدة.`}
        />
        <EServicesGrid services={eServices} />
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-portal]');
    if (!root) return;
    const $ = (sel, parent) => (parent || root).querySelector(sel);

    function logRegistration(payload) {
      if (window.NIASTrack && window.NIASTrack.log) window.NIASTrack.log(payload);
    }

    const msg = $('[data-auth-msg]');
    const views = Array.from(root.querySelectorAll('[data-view]'));
    let session = null;
    let role = 'student';

    function show(name) {
      views.forEach(function (el) {
        el.hidden = el.dataset.view !== name;
      });
    }

    function setMsg(text, kind) {
      msg.hidden = !text;
      msg.textContent = text || '';
      msg.className = 'auth__msg' + (kind === 'ok' ? ' auth__msg--ok' : '');
    }

    function roleLabel(r) {
      if (r === 'trainee') return 'متدرب';
      if (r === 'staff') return 'موظف';
      if (r === 'admin') return 'مدير';
      return 'طالب';
    }

    function enterDashboard(user, r) {
      if (window.NIASAuth) window.NIASAuth.set(user, r);
      window.location.href = '/dashboard';
    }

    root.querySelectorAll('.auth__tab[data-role]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        root.querySelectorAll('.auth__tab[data-role]').forEach(function (t) {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        role = tab.dataset.role;
      });
    });

    $('[data-to-register]').addEventListener('click', function () {
      setMsg('');
      show('register');
    });
    $('[data-to-login]').addEventListener('click', function () {
      setMsg('');
      show('login');
    });
    $('[data-forgot]').addEventListener('click', function () {
      setMsg('للاستعادة تواصل مع القبول عبر البريد: admission@nias-ye.academy', 'ok');
    });

    $('form[data-view="login"]').addEventListener('submit', function (e) {
      e.preventDefault();
      const pid = $('[data-pid]').value.trim();
      const pass = $('[data-pass]').value;
      if (!pid) {
        setMsg('أدخل رقم البطاقة أو رقم الجلوس أولًا.');
        return;
      }
      if (pass.length < 6) {
        setMsg('كلمة المرور يجب ألا تقل عن 6 أحرف.');
        return;
      }
      if (pid === 'admin' && pass === '12345678') {
        session = { name: 'مدير النظام', roleLabel: 'مدير', role: 'admin', pid: pid, phone: '—' };
        logRegistration({
          type: 'login',
          role: 'admin',
          name: 'مدير النظام',
          pid: pid,
          page: location.pathname,
          ts: new Date().toISOString(),
        });
        enterDashboard(session, 'admin');
        return;
      }
      session = { name: 'مستخدم البوابة', roleLabel: roleLabel(role), role: role, pid: pid, phone: '—' };
      logRegistration({
        type: 'login',
        role: role,
        name: roleLabel(role),
        pid: pid,
        page: location.pathname,
        ts: new Date().toISOString(),
      });
      enterDashboard(session, role);
    });

    $('form[data-view="register"]').addEventListener('submit', function (e) {
      e.preventDefault();
      const name = $('[data-r-name]').value.trim();
      const pid = $('[data-r-pid]').value.trim();
      const phone = $('[data-r-phone]').value.trim();
      const pass = $('[data-r-pass]').value;
      if (!name || !pid) {
        setMsg('الاسم الكامل والرقم الأكاديمي مطلوبان.');
        return;
      }
      if (pass.length < 6) {
        setMsg('كلمة المرور يجب ألا تقل عن 6 أحرف.');
        return;
      }
      role = 'student';
      session = { name: name, roleLabel: 'طالب', role: 'student', pid: pid, phone: phone || '—' };
      logRegistration({
        type: 'register',
        role: 'student',
        name: name,
        pid: pid,
        phone: phone || '',
        page: location.pathname,
        ts: new Date().toISOString(),
      });
      enterDashboard(session, role);
    });

    if (window.NIASAuth) {
      session = window.NIASAuth.read();
      role = window.NIASAuth.role();
    }
    if (session) {
      window.location.replace('/dashboard');
    } else {
      show('login');
    }
  })();
</script>

<style>
  .section {
    padding-block: var(--spacing-8);
  }

  .portal-rip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: var(--spacing-8);
  }
  .portal-rip__cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: var(--spacing-4);
    box-shadow: 0 10px 24px rgba(7, 123, 67, 0.06);
  }
  .portal-rip__ic {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    margin-bottom: 6px;
  }
  .portal-rip__cell strong {
    font-size: 1.12rem;
    font-weight: 900;
    color: var(--color-text);
    line-height: 1.4;
  }
  .portal-rip__cell small {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .portal-steps {
    margin-bottom: var(--spacing-8);
  }
  .portal-steps__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }
  .portal-steps__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 0.92rem;
    color: #fff;
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-dark));
    border-radius: 12px;
    padding: 11px 18px;
    box-shadow: 0 12px 26px rgba(7, 123, 67, 0.18);
    transition: transform 0.2s ease, box-shadow 0.25s ease, filter 0.2s ease;
  }
  .portal-steps__cta:hover {
    transform: translateY(-2px);
    filter: saturate(1.08);
    box-shadow: 0 16px 32px rgba(7, 123, 67, 0.24);
  }
  .portal-step__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: var(--spacing-3);
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .portal-step__link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }
  .auth__flow-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .auth__flow-link:hover {
    text-decoration: underline;
  }
  .portal-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-4);
    margin-top: var(--spacing-5);
  }
  .portal-step {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: var(--spacing-5) var(--spacing-5) var(--spacing-5) 44px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .portal-step:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(7, 123, 67, 0.1);
  }
  html[dir="rtl"] .portal-step {
    padding: var(--spacing-5) 44px var(--spacing-5) var(--spacing-5);
  }
  .portal-step__num {
    position: absolute;
    inset-inline-start: 12px;
    top: 10px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-gold-light);
    color: var(--color-accent-dark);
    font-size: 0.78rem;
    font-weight: 900;
    display: grid;
    place-items: center;
  }
  .portal-step__ic {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    margin-bottom: var(--spacing-3);
  }
  .portal-step h3 {
    font-weight: 900;
    font-size: 1.05rem;
    color: var(--color-text);
    margin-bottom: 6px;
  }
  .portal-step p {
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--color-text-secondary);
  }

  .auth {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 22px 50px rgba(7, 123, 67, 0.1);
    margin-bottom: var(--spacing-8);
  }
  .auth__side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    padding: clamp(22px, 3vw, 34px);
    background:
      radial-gradient(420px 260px at 0% 100%, rgba(255, 255, 255, 0.1), transparent 60%),
      linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    overflow: hidden;
  }
  .auth__side-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: var(--color-gold-light);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 999px;
  }
  .auth__side h3 {
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    font-weight: 900;
    line-height: 1.5;
  }
  .auth__side > p {
    color: rgba(234, 244, 238, 0.92);
    font-size: 0.9rem;
    line-height: 1.9;
    max-width: 40ch;
  }
  .auth__side-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: var(--spacing-4);
  }
  .auth__side-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .auth__side-list svg {
    flex-shrink: 0;
    color: var(--color-gold-light);
  }

  .auth__stage {
    padding: clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .auth__msg {
    margin-bottom: var(--spacing-4);
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    background: var(--color-accent-light);
    color: var(--color-accent-dark);
    border: 1px solid var(--color-accent);
  }
  .auth__head {
    text-align: center;
    margin-bottom: var(--spacing-4);
  }
  .auth__head h3 {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-text);
  }
  .auth__head p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: 4px;
  }
  .auth__tabs {
    display: flex;
    gap: var(--spacing-2);
    justify-content: center;
    margin-bottom: var(--spacing-5);
  }
  .auth__tab {
    font-family: inherit;
    cursor: pointer;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-weight: 700;
    font-size: 0.88rem;
    padding: 8px 20px;
    border-radius: 999px;
    transition: all 0.2s ease;
  }
  .auth__tab.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }
  .auth__fields {
    display: grid;
    gap: var(--spacing-4);
    max-width: 520px;
    margin-inline: auto;
  }
  .auth__fields--grid {
    grid-template-columns: 1fr 1fr;
    max-width: 560px;
  }
  .auth__label {
    display: grid;
    gap: 6px;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    text-align: start;
  }
  .auth__label input {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border-dark);
