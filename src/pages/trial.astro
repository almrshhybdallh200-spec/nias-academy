---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { toArabicNumerals, formatDate } from '../lib/format';
import {
  siteConfig,
  branches,
  colleges,
  programs,
  newsItems,
  announcements,
  partners,
  eServices,
  trainingCourses,
  getLatest,
} from '../lib/data';

const latestNews = getLatest(newsItems, 8);
const homeStats = [
  { value: siteConfig.stats.years, label: 'عامًا من العطاء' },
  { value: siteConfig.stats.graduates, label: 'خريج شهادة' },
  { value: siteConfig.stats.trainees, label: 'متدرب وملتحق' },
  { value: siteConfig.stats.branches, label: 'فروع في اليمن' },
];
const services = eServices.slice(0, 6);
const gradPrograms = programs.filter((p) => p.typeLabel === 'دبلوم عالي').slice(0, 3);
const profPrograms = programs.filter((p) => p.typeLabel !== 'دبلوم عالي').slice(0, 3);
const trainings = trainingCourses.slice(0, 3);
const latestAnnouncements = announcements.slice(0, 3);

const navItems = [
  { id: 'path', label: 'ابدأ من هنا' },
  { id: 'services', label: 'الخدمات' },
  { id: 'programs', label: 'البرامج' },
  { id: 'colleges', label: 'الكليات' },
  { id: 'training', label: 'التدريب' },
  { id: 'branches', label: 'الفروع' },
  { id: 'media', label: 'الأخبار' },
  { id: 'faq', label: 'الأسئلة' },
];

const audiences = [
  { icon: 'graduation', title: 'طالب / متقدّم', text: 'التسجيل والملفات والنتائج الأكاديمية.', href: '/portal', cta: 'البوابة الأكاديمية' },
  { icon: 'user', title: 'موظف حكومي', text: 'الدورات التخصصية وشؤون الموظفين.', href: '/training', cta: 'تصفّح التدريب' },
  { icon: 'university', title: 'جهة / مؤسسة', text: 'برامج بناء القدرات والاستشارات.', href: '/about', cta: 'اطلب شراكة' },
  { icon: 'book', title: 'باحث / أكاديمي', text: 'المكتبة الرقمية والأبحاث الإدارية.', href: '/about#library', cta: 'المكتبة الرقمية' },
];

const faqs = [
  { q: 'ما شروط الالتحاق ببرامج الدبلوم العالي؟', a: 'مؤهل بكالوريوس، وخبرة لا تقل عن سنتين في الوظيفة العامة، واجتياز المقابلة الشخصية. تُعلن التفاصيل في صفحة كل برنامج.' },
  { q: 'هل الدراسة صباحية أم مسائية؟', a: 'تتوفر أوضاع متعددة: صباحي، مسائي، وتنفيذي في نهاية الأسبوع بحسب البرنامج، وذلك لمراعاة التزامات الموظفين.' },
  { q: 'كيف أحصل على شهادة معتمدة؟', a: 'عبر خدمة «طلب شهادة معتمدة» في البوابة الأكاديمية؛ تُصدر الشهادة موثّقة ومصدّقة بترميز QR للتحقق.' },
  { q: 'هل يقدّم المعهد برامج للجهات والمؤسسات؟', a: 'نعم، يقدّم المعهد برامج بناء قدرات واستشارات مخصّصة للقطاعين العام والخاص عبر فروع المعهد السبعة.' },
  { q: 'هل توفر خدمة تدريب عن بُعد؟', a: 'نعم، منصة التدريب عن بُعد تقدّم دورات أونلاين بشهادات معتمدة، مع إمكانية الحضور للفروع.' },
];

const designSystem = [
  { n: '01', c: 'Accessibility · CRITICAL', d: 'تباين ≥ 4.5:1، رابط «تخطَّ إلى المحتوى»، حلقة تركيز 3px، إخفاء الأيقونات الزخرفية عن قارئ الشاشة، بنية عناوين متسلسلة.' },
  { n: '02', c: 'Touch & Interaction · CRITICAL', d: 'كل هدف لمس ≥ 44px، تباعد ≥ 8px، حالات pressed/hover/focus، وبديل نقر للتمرير الأفقي.' },
  { n: '03', c: 'Performance · HIGH', d: 'JS صفري في Astro، صور lazy، حجز أبعاد (CLS) عبر aspect-ratio، نصوص system-fallback مع font-display: swap.' },
  { n: '04', c: 'Style Selection · HIGH', d: 'الأسلوب الموحّد: Minimalism & Swiss + Accessible & Ethical + Flat — أيقونات SVG متجهية بلا إيموجي.' },
  { n: '05', c: 'Layout & Responsive · HIGH', d: 'Mobile-first، بلا تمرير أفقي، نقاط توقف 375/768/1024/1440، حدّ قراءة 65–75 حرفًا، Bento Grid حديث.' },
  { n: '06', c: 'Typography & Color · MEDIUM', d: 'أساس 16px، line-height 1.5–1.8، text-wrap: balance للعناوين، رموز ألوان دلالية (CSS variables) لا hex مبعثر.' },
  { n: '07', c: 'Animation · MEDIUM', d: 'انتقالات transform/opacity فقط بمدد 150–300ms، تركيز على عنصر أو عنصرين، احترام prefers-reduced-motion.' },
  { n: '08', c: 'Forms & Feedback · MEDIUM', d: 'تسميات ظاهرة، أخطاء قرب الحقل (aria-describedby)، إفصاح تدريجي عبر <details> الأصلي.' },
  { n: '09', c: 'Navigation Patterns · HIGH', d: 'تنقّل مرساة مع تتبّع القسم النشط (scroll-spy + aria-current)، موضع اتصال ثابت، عمق صفحة واحدة.' },
  { n: '10', c: 'Charts & Data · LOW', d: 'عرض الأرقام كمؤشرات واضحة مع وصف نصّي بديل، وعدم الاعتماد على اللون وحده لنقل المعنى.' },
];
---

<BaseLayout
  title={`الصفحة الرئيسية — نسخة حديثة تجريبية · ${siteConfig.name}`}
  description="نسخة حديثة تجريبية من الصفحة الرئيسية بتطبيق كامل لمهارة UI UX Pro Max: Bento Grid، بوابة أدوار، كاروسيل متاح، وأسئلة شائعة."
>
  <a class="dsx-skip" href="#main">تخطَّ إلى المحتوى الرئيسي</a>

  <div class="dsx">
    <div class="dsx-note" role="note">
      <div class="container dsx-note__inner">
        <span class="dsx-note__badge">تجريبي</span>
        <span>نسخة حديثة بتطبيق كل مهارات <strong>UI UX Pro Max</strong> — الصفحة الأصلية لم تُمسّ.</span>
        <a class="dsx-note__link" href="/">النسخة الأصلية <Icon name="arrow-left" size={14} /></a>
      </div>
    </div>

    <main id="main">
      <header class="dsx-hero">
        <div class="container dsx-hero__grid">
          <div class="dsx-hero__body">
            <p class="dsx-kicker">المعهد الوطني للعلوم الإدارية · منذ {toArabicNumerals(siteConfig.established)}</p>
            <h1>{siteConfig.tagline}</h1>
            <p class="dsx-lead">{siteConfig.footerDescription}</p>
            <div class="dsx-actions">
              <a class="dsx-btn dsx-btn--solid" href={siteConfig.dates.registrationLink}>
                سجّل الآن
                <Icon name="arrow-left" size={18} />
              </a>
              <a class="dsx-btn dsx-btn--line" href="#programs">استكشف البرامج</a>
            </div>
            <p class="dsx-hero__trust">
              <Icon name="shield" size={16} />
              معتمد من وزارة الخدمة المدنية والتأمينات · تسجيل الدفعة {siteConfig.dates.academicYear}
            </p>
            <dl class="dsx-stats">
              {homeStats.map((s) => (
                <div>
                  <dt>{toArabicNumerals(s.value)}</dt>
                  <dd>{s.label}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="dsx-hero__aside">
            <figure class="dsx-hero__media">
              <img src="/images/headquarters2.jpg" alt="مقر المعهد الوطني للعلوم الإدارية — صنعاء" loading="lazy" decoding="async" />
            </figure>
            <div class="dsx-cred">
              <span class="dsx-cred__ic"><Icon name="award" size={20} /></span>
              <div>
                <strong>اعتماد رسمي</strong>
                <span>مؤسسة وطنية لبناء القدرات الإدارية</span>
              </div>
            </div>
          </div>
        </div>
      </header>

      <nav class="dsx-jump" aria-label="أقسام الصفحة">
        <div class="container dsx-jump__inner">
          {navItems.map((n) => (
            <a class="dsx-jump__link" href={`#${n.id}`} data-jump>
              {n.label}
            </a>
          ))}
        </div>
      </nav>

      <section class="dsx-section" id="path">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">01</span>
            <div>
              <h2>ابدأ من هنا</h2>
              <p>اختر هويتك لتصلك الخدمة المناسبة مباشرة.</p>
            </div>
          </div>
          <div class="dsx-grid dsx-grid--paths">
            {audiences.map((a) => (
              <a class="dsx-path" href={a.href}>
                <span class="dsx-path__ic"><Icon name={a.icon} size={24} /></span>
                <strong>{a.title}</strong>
                <small>{a.text}</small>
                <span class="dsx-path__cta">
                  {a.cta}
                  <Icon name="arrow-left" size={15} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="services">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">02</span>
            <div>
              <h2>الخدمات الإلكترونية</h2>
              <p>خدمات رقمية موحّدة في شبكة حديثة (Bento Grid).</p>
            </div>
          </div>
          <div class="dsx-bento">
            {services.map((s, i) => (
              <a class:list={['dsx-tile', i < 2 && 'dsx-tile--feature']} href={s.href}>
                <span class="dsx-tile__ic"><Icon name={s.icon} size={26} /></span>
                <strong>{s.name}</strong>
                <small>{s.description}</small>
                <span class="dsx-tile__go"><Icon name="arrow-left" size={16} /></span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-band" aria-label="أرقام المعهد">
        <div class="container dsx-band__grid">
          {homeStats.map((s) => (
            <div>
              <strong>{toArabicNumerals(s.value)}</strong>
              <span>{s.label}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="dsx-section" id="programs">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">03</span>
            <div>
              <h2>البرامج الأكاديمية</h2>
              <p>مسار متدرّج: دبلومات عالية ثم دبلومات مهنية.</p>
            </div>
          </div>

          <h3 class="dsx-sub">دبلومات عالية</h3>
          <div class="dsx-grid dsx-grid--prog">
            {gradPrograms.map((p) => (
              <article class="dsx-pcard">
                <span class="dsx-pcard__tag">{p.typeLabel}</span>
                <h4>{p.name}</h4>
                <p>{p.overview}</p>
                <ul>
                  <li><Icon name="clock" size={14} />{p.duration}</li>
                  <li><Icon name="book" size={14} />{toArabicNumerals(p.hours)} ساعة</li>
                  <li><Icon name="layers" size={14} />{p.mode}</li>
                </ul>
                <a class="dsx-pcard__more" href={`/media/programs/${p.slug}`}>
                  التفاصيل
                  <Icon name="arrow-left" size={15} />
                </a>
              </article>
            ))}
          </div>

          <h3 class="dsx-sub">دبلومات مهنية</h3>
          <div class="dsx-grid dsx-grid--prog">
            {profPrograms.map((p) => (
              <article class="dsx-pcard">
                <span class="dsx-pcard__tag">{p.typeLabel}</span>
                <h4>{p.name}</h4>
                <p>{p.overview}</p>
                <ul>
                  <li><Icon name="clock" size={14} />{p.duration}</li>
                  <li><Icon name="book" size={14} />{toArabicNumerals(p.hours)} ساعة</li>
                  <li><Icon name="layers" size={14} />{p.mode}</li>
                </ul>
                <a class="dsx-pcard__more" href={`/media/programs/${p.slug}`}>
                  التفاصيل
                  <Icon name="arrow-left" size={15} />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="colleges">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">04</span>
            <div>
              <h2>الكليات</h2>
              <p>ثلاث كليات تغطي الإدارة العامة والمالية والمعلوماتية.</p>
            </div>
          </div>
          <div class="dsx-grid dsx-grid--colleges">
            {colleges.map((c) => (
              <a class="dsx-ccard" href={`/colleges/${c.slug}`}>
                <span class="dsx-ccard__ic"><Icon name={c.icon} size={24} /></span>
                <strong>{c.name}</strong>
                <small>{c.description}</small>
                <ul>
                  {c.goals.map((g) => (
                    <li>{g}</li>
                  ))}
                </ul>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section" id="training">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">05</span>
            <div>
              <h2>البرامج التدريبية</h2>
              <p>دورات تخصصية لكوادر القطاعين العام والخاص.</p>
            </div>
          </div>
          <div class="dsx-grid dsx-grid--prog">
            {trainings.map((t) => (
              <article class="dsx-pcard">
                <span class="dsx-pcard__tag">{t.category}</span>
                <h4>{t.title}</h4>
                <p>{t.summary}</p>
                <ul>
                  <li><Icon name="clock" size={14} />{t.duration}</li>
                  <li><Icon name="book" size={14} />{toArabicNumerals(t.hours)} ساعة</li>
                  <li><Icon name="user" size={14} />{t.instructor}</li>
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="branches">
        <div class="container">
          <div class="dsx-head">
            <span class="dsx-num">06</span>
            <div>
              <h2>الفروع</h2>
              <p>حضور وطني في {toArabicNumerals(siteConfig.stats.branches)} محافظات.</p>
            </div>
          </div>
          <div class="dsx-chips">
            {branches.map((b) => (
              <a class="dsx-chip" href={`/branches/${b.slug}`}>
                <span></span>
                {b.name}
                {b.isDefault && <em>المقر الرئيسي</em>}
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-section" id="media">
        <div class="container">
          <div class="dsx-carousel" data-carousel aria-roledescription="carousel" aria-label="آخر الأخبار">
            <div class="dsx-carousel__head">
              <div class="dsx-head dsx-head--sm">
                <span class="dsx-num">07</span>
                <div><h2>آخر الأخبار</h2></div>
              </div>
              <div class="dsx-carousel__ctrls">
                <button type="button" class="dsx-round" data-carousel-prev aria-label="الخبر السابق">
                  <Icon name="chevron-right" size={18} />
                </button>
                <button type="button" class="dsx-round" data-carousel-next aria-label="الخبر التالي">
                  <Icon name="chevron-left" size={18} />
                </button>
              </div>
            </div>
            <ul class="dsx-carousel__track" data-carousel-track tabindex="0" aria-label="قائمة الأخبار — استخدم الأسهم للتنقل">
              {latestNews.map((n, i) => (
                <li class="dsx-slide" aria-label={`${toArabicNumerals(i + 1)} من ${toArabicNumerals(latestNews.length)}`}>
                  <a href={`/media/news/${n.slug}`}>
                    <span class="dsx-slide__cat">{n.category}</span>
                    <strong>{n.title}</strong>
                    <time>{formatDate(n.date)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="dsx-ann-wrap">
            <div class="dsx-head dsx-head--sm">
              <span class="dsx-num">08</span>
              <div><h2>إعلانات</h2></div>
            </div>
            <ul class="dsx-ann">
              {latestAnnouncements.map((a) => (
                <li>
                  <span>{a.code}</span>
                  <strong>{a.title}</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="dsx-trust" aria-label="جهات تثق بالمعهد">
        <div class="container">
          <p class="dsx-trust__label">جهات تثق بالمعهد</p>
          <ul class="dsx-trust__list">
            {partners.map((p) => (
              <li><Icon name="landmark" size={14} />{p.name}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="dsx-section dsx-section--alt" id="faq">
        <div class="container dsx-faq-wrap">
          <div class="dsx-head">
            <span class="dsx-num">09</span>
            <div>
              <h2>الأسئلة الشائعة</h2>
              <p>إفصاح تدريجي عبر عناصر <code>&lt;details&gt;</code> أصلية تعمل دون JavaScript.</p>
            </div>
          </div>
          <div class="dsx-faq">
            {faqs.map((f) => (
              <details class="dsx-faq__item">
                <summary>
                  <span>{f.q}</span>
                  <Icon name="chevron-down" size={18} />
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="dsx-cta">
        <div class="container dsx-cta__inner">
          <div>
            <h2>انضم إلى أكثر من {toArabicNumerals(siteConfig.stats.graduates)} خريج</h2>
            <p>تسجيل الدفعة {siteConfig.dates.academicYear} مستمر حتى {formatDate(siteConfig.dates.applicationDeadline)}.</p>
          </div>
          <div class="dsx-cta__actions">
            <a class="dsx-btn dsx-btn--gold" href={siteConfig.dates.registrationLink}>
              سجّل الآن
              <Icon name="arrow-left" size={18} />
            </a>
            <a class="dsx-btn dsx-btn--outline" href="/contact">تواصل معنا</a>
          </div>
        </div>
      </section>

      <section class="dsx-section" aria-label="نظام التصميم المطبّق">
        <div class="container">
          <h2 class="dsx-ds__title">نظام التصميم المطبّق <span>UI UX Pro Max</span></h2>
          <ul class="dsx-ds__grid">
            {designSystem.map((r) => (
              <li>
                <span class="dsx-ds__n">{r.n}</span>
                <strong>{r.c}</strong>
                <p>{r.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 96px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  .dsx {
    --g: #0F7A4A;
    --g-d: #0A5C37;
    --g-l: #E4F1E9;
    --ink: #101418;
    --navy: #26304D;
    --gold: #C9A227;
    --bg: #FBFAF7;
    --surf: #ffffff;
    --muted: #5B6470;
    --line: #E4E4DE;
    --focus: #1591B3;
    background: var(--bg);
    color: var(--ink);
  }

  /* ---------- Skip link ---------- */
  .dsx-skip {
    position: absolute;
    inset-inline-start: 12px;
    top: -56px;
    z-index: 100;
    background: var(--g-d, #0A5C37);
    color: #fff;
    font-weight: 800;
    padding: 12px 18px;
    border-radius: 8px;
    transition: top 0.15s ease;
  }
  .dsx-skip:focus {
    top: 12px;
  }

  /* ---------- Trial note ---------- */
  .dsx-note {
    background: var(--navy);
    color: #fff;
  }
  .dsx-note__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 10px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .dsx-note__badge {
    background: var(--gold);
    color: #1B1405;
    font-weight: 800;
    font-size: 0.72rem;
    padding: 3px 12px;
    border-radius: 999px;
  }
  .dsx-note__link {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-weight: 700;
    min-height: 32px;
  }
  .dsx-note__link:hover {
    text-decoration: underline;
  }

  /* ---------- Kicker / headings ---------- */
  .dsx-kicker {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--g-d);
  }
  .dsx-h2,
  .dsx h1,
  .dsx h2 {
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  /* ---------- Hero ---------- */
  .dsx-hero {
    border-bottom: 1px solid var(--line);
    background: var(--surf);
  }
